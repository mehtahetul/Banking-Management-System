# Makefile.day1 - builds the Day 1 programs (Day 4: seed now needs password.c and -lcrypt).
# Use it with:  make -f Makefile.day1
# (Your main Makefile is untouched. Merge these rules in whenever you like.)

CC     = gcc
CFLAGS = -Wall -Wextra -pthread -Icommon -Istorage
LIBS   = -lcrypt

STORAGE  = storage/storage.c
PASSWORD = common/password.c

all: seed dump race

seed: tests/seed.c $(STORAGE) $(PASSWORD) common/structs.h storage/storage.h common/password.h
	$(CC) $(CFLAGS) -o seed tests/seed.c $(STORAGE) $(PASSWORD) $(LIBS)

dump: tests/dump.c $(STORAGE) common/structs.h storage/storage.h
	$(CC) $(CFLAGS) -o dump tests/dump.c $(STORAGE)

race: tests/race.c $(STORAGE) common/structs.h storage/storage.h
	$(CC) $(CFLAGS) -o race tests/race.c $(STORAGE)

test_password: tests/test_password.c $(PASSWORD) common/password.h
	$(CC) $(CFLAGS) -o test_password tests/test_password.c $(PASSWORD) $(LIBS)

clean:
	rm -f seed dump race test_password

.PHONY: all clean
