<mxfile host="app.diagrams.net">
  <diagram id="bank-class-diagram" name="Banking System - Class Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- User -->
        <mxCell id="user" value="User  (users.dat)" style="swimlane;fontStyle=1;align=center;startSize=28;horizontal=1;collapsible=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="270" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="user_f" value="+ user_id : int  (key)&lt;br&gt;+ username : char[32]  (unique)&lt;br&gt;+ password : char[128]&lt;br&gt;+ role : int  (0 cust, 1 emp, 2 mgr, 3 admin)&lt;br&gt;+ name : char[50]&lt;br&gt;+ phone : char[16]&lt;br&gt;+ email : char[50]&lt;br&gt;+ account_id : int  (-1 for staff)&lt;br&gt;+ logged_in : int  (0/1)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="user">
          <mxGeometry y="28" width="270" height="222" as="geometry"/>
        </mxCell>

        <!-- Account -->
        <mxCell id="account" value="Account  (accounts.dat)" style="swimlane;fontStyle=1;align=center;startSize=28;horizontal=1;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="450" y="40" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="account_f" value="+ account_id : int  (key)&lt;br&gt;+ user_id : int  (owner)&lt;br&gt;+ balance : long long  (paise)&lt;br&gt;+ status : int  (0 off, 1 active)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="account">
          <mxGeometry y="28" width="250" height="102" as="geometry"/>
        </mxCell>

        <!-- Transaction -->
        <mxCell id="txn" value="Transaction  (txns.dat)" style="swimlane;fontStyle=1;align=center;startSize=28;horizontal=1;collapsible=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="850" y="40" width="290" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="txn_f" value="+ txn_id : int  (key)&lt;br&gt;+ account_id : int&lt;br&gt;+ type : int  (0 dep, 1 wd, 2 out, 3 in)&lt;br&gt;+ amount : long long  (paise)&lt;br&gt;+ balance_after : long long&lt;br&gt;+ other_account_id : int  (-1 if none)&lt;br&gt;+ timestamp : long long" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="txn">
          <mxGeometry y="28" width="290" height="162" as="geometry"/>
        </mxCell>

        <!-- Loan -->
        <mxCell id="loan" value="Loan  (loans.dat)" style="swimlane;fontStyle=1;align=center;startSize=28;horizontal=1;collapsible=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="450" y="340" width="250" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="loan_f" value="+ loan_id : int  (key)&lt;br&gt;+ account_id : int  (applicant)&lt;br&gt;+ amount : long long  (paise)&lt;br&gt;+ status : int  (0 applied, 1 assigned,&lt;br&gt;&amp;nbsp;&amp;nbsp;2 approved, 3 rejected)&lt;br&gt;+ assigned_to : int  (-1 until assigned)&lt;br&gt;+ applied_time : long long" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="loan">
          <mxGeometry y="28" width="250" height="132" as="geometry"/>
        </mxCell>

        <!-- Feedback -->
        <mxCell id="fb" value="Feedback  (feedback.dat)" style="swimlane;fontStyle=1;align=center;startSize=28;horizontal=1;collapsible=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="fb_f" value="+ feedback_id : int  (key)&lt;br&gt;+ user_id : int  (writer)&lt;br&gt;+ message : char[256]" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="fb">
          <mxGeometry y="28" width="270" height="72" as="geometry"/>
        </mxCell>

        <!-- Relationships -->
        <mxCell id="e_user_account" value="1 : 1&lt;br&gt;owns" style="endArrow=open;endFill=0;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="account">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_txn_account" value="many : 1&lt;br&gt;account_id" style="endArrow=open;endFill=0;html=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="txn" target="account">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_txn_other" value="other_account_id&lt;br&gt;(transfers only)" style="endArrow=open;endFill=0;dashed=1;html=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="txn" target="account">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_loan_account" value="many : 1&lt;br&gt;account_id" style="endArrow=open;endFill=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="loan" target="account">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_loan_user" value="assigned_to&lt;br&gt;(an employee)" style="endArrow=open;endFill=0;dashed=1;html=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="loan" target="user">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_fb_user" value="many : 1&lt;br&gt;user_id" style="endArrow=open;endFill=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fb" target="user">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
